{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StoreObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::my-brainproxy-bucket/brainproxy/*"
    },
    {
      "Sid": "StoreList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::my-brainproxy-bucket",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["brainproxy", "brainproxy/*"]
        }
      }
    },
    {
      "Sid": "EcsExec",
      "Effect": "Allow",
      "Action": [
        "ssmmessages:CreateControlChannel",
        "ssmmessages:CreateDataChannel",
        "ssmmessages:OpenControlChannel",
        "ssmmessages:OpenDataChannel"
      ],
      "Resource": "*"
    }
  ]
}
